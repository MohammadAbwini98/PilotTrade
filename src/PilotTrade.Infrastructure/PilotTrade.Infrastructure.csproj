<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PilotTrade.Domain\PilotTrade.Domain.csproj" />
    <ProjectReference Include="..\PilotTrade.Application\PilotTrade.Application.csproj" />
  </ItemGroup>

  <!-- Evidence must say which commit produced it and whether the tree was clean, which the build version cannot show. -->
  <Target Name="StampGitState" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="StampedGitSha" />
      <Output TaskParameter="ExitCode" PropertyName="StampedGitShaExit" />
    </Exec>
    <Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="StampedGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="StampedGitStatusExit" />
    </Exec>
    <PropertyGroup>
      <StampedGitSha Condition="'$(StampedGitShaExit)' != '0'">unknown</StampedGitSha>
      <StampedWorkingTree>dirty</StampedWorkingTree>
      <StampedWorkingTree Condition="'$(StampedGitStatus)' == ''">clean</StampedWorkingTree>
      <StampedWorkingTree Condition="'$(StampedGitStatusExit)' != '0'">unknown</StampedWorkingTree>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitSha" Value="$(StampedGitSha)" />
      <AssemblyMetadata Include="WorkingTree" Value="$(StampedWorkingTree)" />
    </ItemGroup>
  </Target>

</Project>
